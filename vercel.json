{
  "rewrites": [
    {
      "source": "/api/proxy/deepseek/:match*",
      "destination": "https://api.deepseek.com/:match*"
    },
    {
      "source": "/api/proxy/serpapi/:match*",
      "destination": "https://serpapi.com/:match*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}